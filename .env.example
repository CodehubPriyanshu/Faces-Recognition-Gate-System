# Server-only settings; never prefix credentials with VITE_.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="vigil_guardian_pass"
# On Netlify use the exact deployed site URL (including https).
APP_URL="http://localhost:8080"
# Replace with a random secret of at least 32 characters.
AUTH_SECRET=""
SESSION_TTL_HOURS="12"

# Only used by db:seed; password needs 8+ chars, uppercase, and a number.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD=""

# Supabase is not used. SUPABASE_SERVICE_ROLE_KEY must never have a VITE_ prefix.
